{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://francoromeu.fr/schemas/fr-autoedite-edit-plan-v3.json",
  "title": "FR AutoEdite — Edit Plan v3",
  "type": "object",
  "required": ["schema_version", "project", "output", "versions", "audio", "segments"],
  "properties": {
    "schema_version": {"const": 3},
    "project": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1}
      }
    },
    "order_mode": {"enum": ["automatico", "cronologico", "alfabetico", "aleatorio"]},
    "random_seed": {"type": "integer", "minimum": 0},
    "output": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 240},
        "height": {"type": "integer", "minimum": 240},
        "fps": {"type": "integer", "minimum": 12, "maximum": 60},
        "render_source": {"enum": ["originals", "proxies"]},
        "delivery_label": {"type": "string"}
      }
    },
    "versions": {
      "type": "object",
      "properties": {
        "branded": {"type": "boolean"},
        "clean": {"type": "boolean"}
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "preserve_original": {"type": "boolean"},
        "music_path": {"type": "string"},
        "music_volume": {"type": "number", "minimum": 0, "maximum": 1},
        "auto_ducking": {"type": "boolean"},
        "enable_sfx": {"type": "boolean"},
        "sfx_volume": {"type": "number", "minimum": 0, "maximum": 1},
        "tts_voiceover": {"type": "boolean"},
        "tts_language": {"type": "string"}
      }
    },
    "visual_effects": {
      "type": "object",
      "properties": {
        "transitions": {"type": "array", "items": {"enum": ["fade", "fade_black", "fade_white", "dissolve", "pixelize", "blur", "zoom_in", "zoom_swipe", "slide_left", "slide_right", "slide_up", "slide_down", "smooth_left", "smooth_right", "smooth_up", "smooth_down", "wipe_left", "wipe_right", "wipe_up", "wipe_down", "diagonal_tl", "diagonal_tr", "diagonal_bl", "diagonal_br", "circle_open", "circle_close", "radial", "squeeze_horizontal", "squeeze_vertical"]}},
        "transition_duration_sec": {"type": "number", "minimum": 0.08, "maximum": 2},
        "color_lut": {"type": "string"},
        "enable_stabilization": {"type": "boolean"},
        "ken_burns_on_images": {"type": "boolean"},
        "speed_ramping": {"type": "boolean"},
        "editorial_timelapse": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "speed_factor": {"type": "number", "minimum": 1.25, "maximum": 30},
            "minimum_source_duration_sec": {"type": "number", "minimum": 3, "maximum": 3600},
            "output_duration_sec": {"type": "number", "minimum": 0.75, "maximum": 30},
            "max_segments": {"type": "integer", "minimum": 1, "maximum": 30},
            "mute_original_audio": {"type": "boolean"}
          }
        }
      }
    },
    "export_quality": {
      "type": "object",
      "properties": {
        "draft_mode": {"type": "boolean"},
        "parallel_workers": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_lot_mb": {"type": "number", "minimum": 10, "maximum": 149}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "type", "include_in", "duration_sec"],
        "properties": {
          "segment_id": {"type": "string", "pattern": "^S[0-9]{4,}$"},
          "type": {"enum": ["card", "media"]},
          "enabled": {"type": "boolean"},
          "include_in": {
            "type": "array",
            "items": {"enum": ["branded", "clean"]}
          },
          "duration_sec": {"type": "number", "exclusiveMinimum": 0},
          "media_id": {"type": "string", "pattern": "^(M[0-9]{4,}(C[0-9]{3})?|EXTERNAL_(INTRO|OUTRO))$"},
          "external_asset": {"type": "boolean"},
          "external_role": {"enum": ["intro", "outro"]},
          "include_in_reels": {"type": "boolean"},
          "source_path": {"type": "string"},
          "proxy_path": {"type": "string"},
          "media_type": {"enum": ["video", "image"]},
          "has_audio": {"type": "boolean"},
          "start_sec": {"type": "number", "minimum": 0},
          "phase_order": {"type": "integer", "minimum": 0},
          "phase_title": {"type": "string"},
          "technical_note": {"type": "string"},
          "on_screen_text": {"type": "string"},
          "lower_third": {"type": "boolean"},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
          "transition": {"enum": ["fade", "fade_black", "fade_white", "dissolve", "pixelize", "blur", "zoom_in", "zoom_swipe", "slide_left", "slide_right", "slide_up", "slide_down", "smooth_left", "smooth_right", "smooth_up", "smooth_down", "wipe_left", "wipe_right", "wipe_up", "wipe_down", "diagonal_tl", "diagonal_tr", "diagonal_bl", "diagonal_br", "circle_open", "circle_close", "radial", "squeeze_horizontal", "squeeze_vertical"]},
          "image_animation": {"enum": ["none", "zoom_in", "zoom_out"]},
          "needs_stabilization": {"type": "boolean"},
          "needs_human_confirmation": {"type": "boolean"},
          "coverage_role": {"enum": ["inicio", "meio", "fim"]},
          "force_stabilization": {"type": "boolean"},
          "editorial_timelapse": {"type": "boolean"},
          "playback_speed": {"type": "number", "minimum": 1, "maximum": 30},
          "card_kind": {"enum": ["intro", "service", "phase", "outro"]},
          "service_key": {"type": "string"},
          "service_asset": {"type": "string"},
          "title": {"type": "string"},
          "body": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "media"}}},
            "then": {"required": ["media_id", "source_path", "proxy_path", "media_type", "start_sec"]}
          },
          {
            "if": {"properties": {"type": {"const": "card"}}},
            "then": {"required": ["title", "body", "card_kind"]}
          }
        ]
      }
    }
  }
}
