{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fr-autoedite:roteiro-mestre:4.0.0",
  "title": "Roteiro Mestre FR AutoEdite 4.0.0",
  "type": "object",
  "properties": {
    "contrato_versao": {
      "const": "4.0.0",
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input_mode": {
      "type": "string",
      "enum": [
        "raw_media",
        "ready_video"
      ]
    },
    "base_video_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "timeline_locked": {
      "type": "boolean"
    },
    "allow_duration_extension": {
      "type": "boolean"
    },
    "duracao_final_estimada_sec": {
      "type": "number",
      "minimum": 0.4,
      "maximum": 21600
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      },
      "maxItems": 500
    },
    "cuts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cut"
      },
      "maxItems": 5000
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/overlay"
      },
      "maxItems": 500
    },
    "audio": {
      "$ref": "#/$defs/audio"
    },
    "captions": {
      "$ref": "#/$defs/captions"
    },
    "social": {
      "$ref": "#/$defs/social"
    },
    "style_pack_id": {
      "type": "string",
      "maxLength": 64
    },
    "notas_editoriais": {
      "type": "string",
      "maxLength": 8000
    },
    "legacy_payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "main_timeline": {
      "type": ["object", "null"]
    },
    "audio_policy": {
      "type": ["string", "null"],
      "enum": ["preserve", "mix", null]
    },
    "allowed_values": {
      "type": ["object", "null"]
    }
  },
  "required": [
    "contrato_versao",
    "project_id",
    "input_mode",
    "timeline_locked",
    "allow_duration_extension",
    "duracao_final_estimada_sec",
    "chapters",
    "cuts",
    "overlays",
    "audio",
    "captions",
    "social",
    "style_pack_id",
    "notas_editoriais"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 500
        },
        "fonte": {
          "type": "string",
          "maxLength": 1000
        },
        "confirmado_por": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "titulo": {
          "type": "string",
          "maxLength": 120
        },
        "start_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 21600
        },
        "end_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 21600
        }
      },
      "required": [
        "id",
        "titulo",
        "start_sec",
        "end_sec"
      ],
      "additionalProperties": false
    },
    "cut": {
      "type": "object",
      "properties": {
        "media_id": {
          "type": "string",
          "maxLength": 128
        },
        "start_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 21600
        },
        "end_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 21600
        },
        "transicao_in": {
          "type": "string",
          "enum": [
            "cut",
            "fade",
            "fade_black",
            "dissolve"
          ]
        },
        "transicao_out": {
          "type": "string",
          "enum": [
            "cut",
            "fade",
            "fade_black",
            "dissolve"
          ]
        }
      },
      "required": [
        "media_id",
        "start_sec",
        "end_sec",
        "transicao_in",
        "transicao_out"
      ],
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "properties": {
        "overlay_id": {
          "type": "string",
          "maxLength": 64
        },
        "kind": {
          "type": "string",
          "enum": [
            "service_card",
            "common_card",
            "balloon",
            "callout",
            "lower_third",
            "caption",
            "logo"
          ]
        },
        "start_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 21600
        },
        "end_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 21600
        },
        "text": {
          "type": "string",
          "maxLength": 220
        },
        "service_key": {
          "type": "string",
          "maxLength": 64
        },
        "asset_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "presentation": {
          "type": "string",
          "enum": [
            "overlay",
            "full_frame"
          ]
        },
        "position": {
          "type": "string",
          "enum": [
            "top_left",
            "top_center",
            "top_right",
            "center",
            "bottom_left",
            "bottom_center",
            "bottom_right"
          ]
        },
        "safe_area": {
          "type": "string",
          "enum": [
            "auto",
            "title_safe",
            "action_safe"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "animation_in": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "slide_up",
            "slide_down",
            "soft_scale"
          ]
        },
        "animation_out": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "slide_up",
            "slide_down",
            "soft_scale"
          ]
        },
        "audio_policy": {
          "type": "string",
          "enum": [
            "preserve",
            "mix"
          ]
        },
        "media_status": {
          "type": "string",
          "enum": [
            "obra_real",
            "projeto_3d",
            "conceito",
            "referencia",
            "estudo",
            "processo"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 30
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "overlay_id",
        "kind",
        "start_sec",
        "end_sec",
        "text",
        "service_key",
        "asset_id",
        "presentation",
        "position",
        "safe_area",
        "opacity",
        "animation_in",
        "animation_out",
        "audio_policy"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "preserve_original": {
          "type": "boolean"
        },
        "music_asset_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "music_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ducking": {
          "type": "boolean"
        },
        "normalize_lufs": {
          "type": [
            "number",
            "null"
          ],
          "enum": [
            -14,
            -16,
            -23,
            null
          ]
        }
      },
      "required": [
        "preserve_original",
        "music_asset_id",
        "music_volume",
        "ducking",
        "normalize_lufs"
      ],
      "additionalProperties": false
    },
    "captions": {
      "type": "object",
      "properties": {
        "gerar_srt": {
          "type": "boolean"
        },
        "queimar": {
          "type": "boolean"
        },
        "estilo": {
          "type": "string",
          "enum": [
            "quiet_luxury_minimal"
          ]
        }
      },
      "required": [
        "gerar_srt",
        "queimar",
        "estilo"
      ],
      "additionalProperties": false
    },
    "slide": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cover",
            "outro",
            "card",
            "media",
            "before_after"
          ]
        },
        "media_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "texto": {
          "type": "string",
          "maxLength": 220
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 30
        }
      },
      "required": [
        "kind",
        "media_id",
        "texto"
      ],
      "additionalProperties": false
    },
    "social": {
      "type": "object",
      "properties": {
        "reels_sec": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "stories_partes_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "carrossel_slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slide"
          },
          "maxItems": 100
        }
      },
      "required": [
        "reels_sec",
        "stories_partes_sec",
        "carrossel_slides"
      ],
      "additionalProperties": false
    }
  }
}
